MODE=paper
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem

STARTING_EQUITY=1000
DAILY_LOSS_PCT=0.10
DAILY_LOSS_USD=100
PER_TRADE_RISK_USD=25
MAX_EXPOSURE_USD=150
MAX_TRADES_PER_DAY=48
MAX_DRAWDOWN_PCT=0.25
MAX_CONTRACTS=10
MAX_SPREAD=0.08
MIN_EDGE=0.08
UNCERTAINTY_K=0.05
SLIPPAGE_TICKS=3            # limit = ask + N ticks. EV is priced at that
                            # worse level, so raising it makes the bot MORE
                            # selective, not more reckless. 1 tick failed to
                            # fill 4/4 live: micro fires exactly when the book
                            # is moving, so it always faces the fast case.
ENTRY_START_SEC=90
ENTRY_CUTOFF_SEC=75
POLL_SEC=2.0
# DEFAULT_VOL_BPS intentionally unset: assets.py holds a measured value per coin.
