[Unit]
Description=Crypto 15m Kalshi paper trader (%i)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cam/projects/crypto-15m-bot
Environment=PYTHONUNBUFFERED=1
Environment=ASSET=%i
ExecStart=/home/cam/projects/crypto-15m-bot/.venv/bin/python -m crypto15m paper
StandardOutput=append:/home/cam/projects/crypto-15m-bot/data/%i/paper.log
StandardError=append:/home/cam/projects/crypto-15m-bot/data/%i/paper.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
