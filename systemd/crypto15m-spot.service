[Unit]
Description=Crypto 15m Coinbase spot streamer (Stage A - nothing reads it yet)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cam/projects/crypto-15m-bot
Environment=PYTHONUNBUFFERED=1 PYTHONPATH=/home/cam/projects/crypto-15m-bot/src ASSET=sol
ExecStart=/home/cam/projects/crypto-15m-bot/.venv/bin/python -m crypto15m.perception.spot_stream
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
